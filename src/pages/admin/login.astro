---
import { SITE_CONFIG } from '../../config.ts';
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>管理登录 — {SITE_CONFIG.siteName}</title>
  <script is:inline>
    (function() {
      // 三态主题：'light' / 'dark' 强制，'auto' 或未设置 → 跟随系统
      const stored = localStorage.getItem('theme');
      const isDark = (stored === 'dark') || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (isDark) document.documentElement.classList.add('dark');
    })();
  </script>
</head>
<body class="bg-[#FAFAFA] dark:bg-[#0F0F0F] min-h-screen flex items-center justify-center p-4">

  <!-- 主题切换（右上角浮动） -->
  <button id="login-theme-btn" title="切换深色/浅色" class="fixed top-5 right-5 w-10 h-10 flex items-center justify-center rounded-full bg-white/70 dark:bg-[#1A1A1A]/70 backdrop-blur-md border border-[#EAEAEA] dark:border-[#2A2A2A] text-[#8B7CB3] shadow-sm hover:scale-110 active:scale-90 transition-all cursor-pointer z-50">
    <svg id="login-icon-sun" class="w-4.5 h-4.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
    <svg id="login-icon-moon" class="w-4.5 h-4.5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
  </button>

  <div class="w-full max-w-[380px]">
    <!-- 站点名 -->
    <a href="/" class="block text-center text-xl font-bold text-[#1A1A1A] dark:text-[#EAEAEA] no-underline mb-12 tracking-tight">
      {SITE_CONFIG.siteName}
    </a>

    <!-- 登录卡片 -->
    <div class="bg-white dark:bg-[#1A1A1A] rounded-3xl p-8 shadow-sm border border-[#EAEAEA] dark:border-[#2A2A2A]">
      <h1 id="login-title" class="text-lg font-bold text-[#1A1A1A] dark:text-[#EAEAEA] mb-2">管理登录</h1>
      <p id="login-desc" class="text-sm text-[#999] mb-6">请输入管理密码</p>

      <!-- 密码输入 -->
      <div class="mb-4">
        <input
          id="password-input"
          type="password"
          placeholder="密码"
          class="w-full px-4 py-3 rounded-2xl border border-[#E0E0E0] dark:border-[#333] bg-[#FAFAFA] dark:bg-[#252525] text-[#1A1A1A] dark:text-[#EAEAEA] text-sm outline-none focus:border-[#8B7CB3] focus:ring-2 focus:ring-[#8B7CB3]/20 transition-all"
        />
      </div>

      <!-- 错误提示 -->
      <div id="error-msg" class="hidden text-xs text-red-500 mb-4"></div>

      <!-- 提交按钮 -->
      <button
        id="submit-btn"
        class="w-full py-3 rounded-2xl bg-[#1A1A1A] dark:bg-[#EAEAEA] text-white dark:text-[#1A1A1A] text-sm font-bold hover:bg-[#8B7CB3] dark:hover:bg-[#8B7CB3] dark:hover:text-white active:scale-[0.98] transition-all cursor-pointer outline-none border-none"
      >
        登录
      </button>
    </div>

    <!-- 返回首页 -->
    <a href="/" class="block text-center text-xs text-[#999] hover:text-[#666] dark:hover:text-[#AAA] mt-6 no-underline transition-colors">
      ← 返回首页
    </a>
  </div>

  <script is:inline>
    const input = document.getElementById('password-input');
    const btn = document.getElementById('submit-btn');
    const error = document.getElementById('error-msg');
    const title = document.getElementById('login-title');
    const desc = document.getElementById('login-desc');

    // —— 检查是否为首次设置 ——
    async function checkSetup() {
      try {
        const res = await fetch('/api/auth');
        const data = await res.json();
        // 如果已登录，直接跳转管理主页
        if (data.logged_in) {
          window.location.href = '/admin';
          return;
        }
      } catch (e) {
        // 忽略网络错误
      }
    }
    checkSetup();

    // —— 提交 ——
    btn.addEventListener('click', async () => {
      const password = input.value.trim();
      if (!password || password.length < 4) {
        showError('密码至少 4 位');
        return;
      }

      btn.disabled = true;
      btn.textContent = '验证中...';
      hideError();

      try {
        const res = await fetch('/api/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        const data = await res.json();

        if (data.success) {
          if (data.setup) {
            // 首次设置密码 —— 提示用户
            title.textContent = '密码已设置';
            desc.textContent = '这是你的管理员密码，请牢记。正在跳转...';
            btn.textContent = '✓ 完成';
            setTimeout(() => { window.location.href = '/admin'; }, 1500);
          } else {
            // 正常登录成功
            window.location.href = '/admin';
          }
        } else {
          showError(data.error || '登录失败');
          btn.disabled = false;
          btn.textContent = '登录';
          input.value = '';
          input.focus();
        }
      } catch (e) {
        showError('网络错误，请重试');
        btn.disabled = false;
        btn.textContent = '登录';
      }
    });

    // 回车提交
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') btn.click();
    });

    function showError(msg) {
      error.textContent = msg;
      error.classList.remove('hidden');
    }
    function hideError() {
      error.classList.add('hidden');
    }

    // 自动聚焦
    input.focus();

    // —— 主题切换 ——
    (function initLoginTheme() {
      const btn = document.getElementById('login-theme-btn');
      const iconSun = document.getElementById('login-icon-sun');
      const iconMoon = document.getElementById('login-icon-moon');
      function updateIcon() {
        const isDark = document.documentElement.classList.contains('dark');
        if (iconSun) iconSun.classList.toggle('hidden', !isDark);
        if (iconMoon) iconMoon.classList.toggle('hidden', isDark);
      }
      updateIcon();
      if (btn) btn.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
        const isDark = document.documentElement.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcon();
      });
    })();
  </script>
</body>
</html>
