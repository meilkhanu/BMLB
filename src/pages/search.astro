---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config.ts';

// 从 URL 读取查询参数，用于 SSR 初始渲染 + 客户端渐进增强
const query = Astro.url.searchParams.get('q') || '';

const catMap = Object.fromEntries(
  SITE_CONFIG.categories.map(c => [c.id, { name: c.name, color: c.color }])
);
---

<BaseLayout title={query ? `搜索: ${query} — 贝谟拉比` : '搜索 — 贝谟拉比'}>
  <div class="container mx-auto px-4 py-12 relative z-10">
    <div class="max-w-[860px] mx-auto px-4 md:px-6 pt-28 pb-16">

      <!-- 标题区 -->
      <div class="mb-10" data-animate>
        <h1 class="text-4xl md:text-5xl font-black text-[#1A1A1A] dark:text-[#EAEAEA] mb-3 tracking-tight">Search</h1>
        <p class="text-base text-[#666] dark:text-[#999] tracking-wide">搜索文章与作品集</p>
      </div>

      <!-- 搜索框 -->
      <div class="relative mb-8" data-animate>
        <div class="relative flex items-center bg-white dark:bg-[#1A1A1A] rounded-2xl shadow-sm border border-[#E5E5E5] dark:border-[#2A2A2A] focus-within:border-[#8B7CB3] transition-all duration-300 overflow-hidden">
          <svg class="w-5 h-5 ml-5 text-[#999] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="search-page-input"
            placeholder="输入关键词，按 Enter 搜索…"
            value={query}
            autocomplete="off"
            class="flex-1 px-4 py-4 text-base bg-transparent border-none outline-none text-[#1A1A1A] dark:text-[#EAEAEA] placeholder-[#999]"
          />
          <button
            id="search-clear-btn"
            type="button"
            class="hidden mr-3 w-7 h-7 flex items-center justify-center rounded-full hover:bg-black/5 dark:hover:bg-white/10 transition-all text-[#999] cursor-pointer border-none flex-shrink-0"
            aria-label="清除"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- 结果区 -->
      <div id="search-results-container" data-animate>
        <!-- SSR 初始状态：未搜索时显示提示 -->
        <div id="search-placeholder" class="text-center py-20">
          <svg class="w-16 h-16 mx-auto mb-4 text-[#D5D5D5] dark:text-[#333]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <p class="text-sm text-[#999]">输入关键词开始搜索</p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<!-- 隐藏的分类映射，供客户端 JS 使用 -->
<script type="application/json" id="cat-map-data" set:html={JSON.stringify(catMap)} />

<script is:inline>
  (function () {
    const input = document.getElementById('search-page-input');
    const clearBtn = document.getElementById('search-clear-btn');
    const container = document.getElementById('search-results-container');
    const placeholder = document.getElementById('search-placeholder');
    const catMapEl = document.getElementById('cat-map-data');
    const catMap = catMapEl ? JSON.parse(catMapEl.textContent || '{}') : {};

    let debounceTimer = null;
    let currentAbort = null;

    // SSR 已经把 q 写入 input.value，如果有初始查询就立即触发搜索
    const initialQ = (input && input.value) || '';
    if (initialQ) {
      doSearch(initialQ);
    }

    if (input) {
      // 输入防抖 300ms
      input.addEventListener('input', () => {
        const q = input.value.trim();
        clearBtn && clearBtn.classList.toggle('hidden', !q);
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          // 更新 URL（不刷新页面）
          const url = new URL(window.location.href);
          if (q) url.searchParams.set('q', q);
          else url.searchParams.delete('q');
          window.history.replaceState({}, '', url.toString());
          doSearch(q);
        }, 300);
      });

      // Enter 立即搜索
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          clearTimeout(debounceTimer);
          doSearch(input.value.trim());
        }
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (input) {
          input.value = '';
          input.focus();
          clearBtn.classList.add('hidden');
          const url = new URL(window.location.href);
          url.searchParams.delete('q');
          window.history.replaceState({}, '', url.toString());
          renderEmpty();
        }
      });
    }

    function renderEmpty() {
      if (!container) return;
      container.innerHTML = `
        <div class="text-center py-20">
          <svg class="w-16 h-16 mx-auto mb-4 text-[#D5D5D5] dark:text-[#333]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <p class="text-sm text-[#999]">输入关键词开始搜索</p>
        </div>
      `;
    }

    function renderLoading(q) {
      if (!container) return;
      container.innerHTML = `
        <div class="flex items-center gap-3 py-16 justify-center">
          <div class="w-5 h-5 border-2 border-[#8B7CB3] border-t-transparent rounded-full animate-spin"></div>
          <span class="text-sm text-[#999]">搜索 "${escapeHtml(q)}" 中…</span>
        </div>
      `;
    }

    function renderNoResults(q) {
      if (!container) return;
      container.innerHTML = `
        <div class="text-center py-20">
          <p class="text-base text-[#666] dark:text-[#999] mb-2">
            未找到与 "${escapeHtml(q)}" 相关的内容
          </p>
          <p class="text-xs text-[#999]">试试其他关键词？</p>
        </div>
      `;
    }

    function renderError() {
      if (!container) return;
      container.innerHTML = `
        <div class="text-center py-20">
          <p class="text-sm text-[#FF1A4D] mb-1">搜索失败</p>
          <p class="text-xs text-[#999]">请稍后重试</p>
        </div>
      `;
    }

    function renderResults(data) {
      if (!container) return;
      const { query, total, results } = data;
      if (!results || results.length === 0) {
        renderNoResults(query);
        return;
      }

      // 按类型分组统计
      const postCount = results.filter(r => r.type === 'post').length;
      const workCount = results.filter(r => r.type === 'work').length;

      let html = `
        <div class="mb-6 flex items-center justify-between flex-wrap gap-2">
          <p class="text-sm text-[#666] dark:text-[#999]">
            找到 <span class="font-bold text-[#1A1A1A] dark:text-[#EAEAEA]">${total}</span> 条结果
            ${postCount ? `<span class="ml-1 text-xs text-[#999]">· 文章 ${postCount}</span>` : ''}
            ${workCount ? `<span class="ml-1 text-xs text-[#999]">· 作品 ${workCount}</span>` : ''}
          </p>
        </div>
        <div class="flex flex-col gap-3">
      `;

      for (const r of results) {
        const isPost = r.type === 'post';
        const cat = isPost ? (catMap[r.category] || { name: r.category, color: '#8B7CB3' }) : null;
        const typeLabel = isPost ? '文章'
          : (r.featured ? '作品 · 精选' : '作品');
        const typeColor = isPost ? (cat ? cat.color : '#8B7CB3') : '#E8913A';

        const tagsHtml = (r.tags && r.tags.length)
          ? `<div class="flex flex-wrap gap-1.5 mt-2">${r.tags.slice(0, 5).map(t => `<span class="px-2 py-0.5 rounded-md text-[10px] bg-[#F5F5F5] dark:bg-[#252525] text-[#999]">${escapeHtml(t)}</span>`).join('')}</div>`
          : '';

        const imgHtml = r.image
          ? `<div class="w-20 h-20 rounded-xl overflow-hidden flex-shrink-0 bg-[#F5F5F5] dark:bg-[#252525]"><img src="${escapeHtml(r.image)}" class="w-full h-full object-cover" alt="${escapeHtml(r.title)}" loading="lazy" /></div>`
          : '';

        const dateStr = r.publishedAt ? formatDate(r.publishedAt) : '';

        html += `
          <a href="${r.href ? escapeHtml(r.href) : 'javascript:void(0)'}"
             class="group flex gap-4 bg-white dark:bg-[#1A1A1A] rounded-2xl p-4 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 border border-transparent hover:border-[#8B7CB3]/20 ${r.href ? 'cursor-pointer' : 'cursor-default'} no-underline">
            ${imgHtml}
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold tracking-wide" style="background-color:${typeColor}18;color:${typeColor}">${typeLabel}</span>
                ${isPost && cat ? `<span class="text-[10px] text-[#999]">${escapeHtml(cat.name)}</span>` : ''}
                ${dateStr ? `<span class="text-[10px] text-[#999]">· ${dateStr}</span>` : ''}
              </div>
              <h3 class="text-base font-semibold text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#8B7CB3] transition-colors duration-300 truncate">${escapeHtml(r.title)}</h3>
              ${r.excerpt ? `<p class="text-sm text-[#666] dark:text-[#999] mt-1 line-clamp-2 leading-relaxed">${escapeHtml(r.excerpt)}</p>` : ''}
              ${tagsHtml}
            </div>
          </a>
        `;
      }

      html += '</div>';
      container.innerHTML = html;
    }

    async function doSearch(q) {
      if (!q) {
        renderEmpty();
        return;
      }

      // 中断上一个请求
      if (currentAbort) currentAbort.abort();
      currentAbort = new AbortController();

      renderLoading(q);

      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`, {
          signal: currentAbort.signal,
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        renderResults(data);
      } catch (e) {
        if (e.name === 'AbortError') return; // 被新请求替代，忽略
        console.error('[search] fetch error:', e);
        renderError();
      }
    }

    function escapeHtml(s) {
      if (s == null) return '';
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      })[c]);
    }

    function formatDate(dateStr) {
      try {
        const d = new Date(dateStr);
        if (isNaN(d.getTime())) return '';
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      } catch {
        return '';
      }
    }

    // 清除按钮初始可见性
    if (input && input.value.trim()) {
      clearBtn && clearBtn.classList.remove('hidden');
    }
  })();
</script>
