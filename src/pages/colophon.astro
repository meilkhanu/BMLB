<script is:inline>
function initColophonNav() {

  // 点击跳转
  document.querySelectorAll('.nav-jump').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.target;
      const el = document.getElementById(id);

      const top = el.getBoundingClientRect().top + window.scrollY - 90;
		window.scrollTo({
  		top,
  		behavior: 'smooth'
		});
    });
  });

  // 高亮逻辑
  const groupBtns = document.querySelectorAll('.nav-group-btn');

  function updateNavActive(activeId) {
    groupBtns.forEach(btn => {
      if (btn.dataset.target === activeId) {
        btn.classList.add('nav-active');
      } else {
        btn.classList.remove('nav-active');
      }
    });
  }

  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter(e => e.isIntersecting);

    if (!visible.length) return;

    const topMost = visible.reduce((a, b) =>
      a.boundingClientRect.top < b.boundingClientRect.top ? a : b
    );

    updateNavActive(topMost.target.id);

  }, {
    rootMargin: '-20% 0px -60% 0px',
    threshold: 0
  });

  ['spirit', 'system', 'final'].forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
}

function initColophonNav() {
  const nav = document.getElementById('colophon-nav');
  const aside = document.getElementById('colophon-aside');
  const indicator = document.getElementById('nav-indicator');
  const allNavBtns = document.querySelectorAll('.nav-jump');

  if (!nav || !aside || !indicator || allNavBtns.length === 0) return;

  // 1. 平滑滚动点击事件
  allNavBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.target;
      const el = document.getElementById(id);
      if (el) {
		if (el) {
        const top = el.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top, behavior: 'smooth' });
      }      }
    });
  });

  // 2. 核心：计算 Y 坐标并驱动胶囊滑动
  function updateNavActive(activeId) {
    let activeBtn = null;

    allNavBtns.forEach(btn => {
      if (btn.dataset.target === activeId) {
        btn.classList.add('nav-active');
        activeBtn = btn;
      } else {
        btn.classList.remove('nav-active');
      }
    });

    if (activeBtn) {
      // 计算激活文字相对于父容器的相对高度
      const navRect = nav.getBoundingClientRect();
      const btnRect = activeBtn.getBoundingClientRect();
      const offsetTop = btnRect.top - navRect.top;
      
      // 让 16px 高的紫色胶囊与文字垂直居中对齐
      const indicatorHeight = 16;
      const translateY = offsetTop + (btnRect.height - indicatorHeight) / 2;

      indicator.style.transform = `translateY(${translateY}px)`;
      indicator.style.opacity = '1';
    }
  }

  // 3. ScrollSpy 交叉观察器
  const observer = new IntersectionObserver((entries) => {
    // A. 探测 Final 区域，执行导航淡出
    const finalEntry = entries.find(e => e.target.id === 'final');
    if (finalEntry) {
      if (finalEntry.isIntersecting) {
        aside.classList.add('opacity-0', 'pointer-events-none');
      } else {
        aside.classList.remove('opacity-0', 'pointer-events-none');
      }
    }

    // B. 常规的高亮逻辑，过滤掉 final 防止过度干扰
    const visible = entries.filter(e => e.isIntersecting && e.target.id !== 'final');
    if (!visible.length) return;

    // 选出处于视口最高位置的区块
    const topMost = visible.reduce((a, b) =>
      a.boundingClientRect.top < b.boundingClientRect.top ? a : b
    );

    updateNavActive(topMost.target.id);

  }, {
    rootMargin: '-15% 0px -70% 0px', // 触须范围：顶部向下 15%，底部向上 70% 为检测区
    threshold: 0
  });

  // 4. 动态抓取所有在导航里注册过的小节 ID 进行精细化监听
  const targetIds = Array.from(allNavBtns).map(btn => btn.dataset.target);
  if (!targetIds.includes('final')) targetIds.push('final');

  targetIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
}

document.addEventListener('DOMContentLoaded', initColophonNav);
document.addEventListener('astro:page-load', initColophonNav);

function initColophon() {
  // ================= 1. 打字机与文案浮现逻辑 =================
  const textElement = document.getElementById('typewriter-text');
  if (textElement) {
    const text = '/colophon';
    let isDeleting = false;
    let i = 0;

    // 清除之前的定时器，防止 Astro 路由切换导致鬼畜重影
    if (window.typewriterTimeout) clearTimeout(window.typewriterTimeout);
    if (window.fadeTimeout) clearTimeout(window.fadeTimeout);

    textElement.textContent = '';

    function type() {
      const currentText = text.substring(0, i);
      textElement.textContent = currentText;

      // 敲击节奏随机化 (100ms - 200ms)
      let delta = 100 + Math.random() * 100;

      if (isDeleting) {
        delta = 50; // 删除速度快
        i--;
      } else {
        i++;
      }

      if (!isDeleting && i === text.length + 1) {
        // 打完字，停顿 8 秒
        isDeleting = true;
        delta = 8000; 
        i = text.length;
      } else if (isDeleting && i === 0) {
        // 删完字，停顿 1.5 秒
        isDeleting = false;
        delta = 1500;
      }

      window.typewriterTimeout = setTimeout(type, delta);
    }

    // 延迟 400ms 启动打字机
    window.typewriterTimeout = setTimeout(type, 400);

    // 延迟 1200ms 启动文案浮现（撕掉透明度伪装）
    window.fadeTimeout = setTimeout(() => {
      document.querySelectorAll('.hero-fade-text').forEach(el => {
        el.classList.remove('opacity-0', 'translate-y-4');
      });
    }, 1200);
  }
}

document.addEventListener('DOMContentLoaded', initColophon);
document.addEventListener('astro:page-load', initColophon);
</script>
