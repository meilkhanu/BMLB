---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config.ts';
import { getDb } from '../lib/db';

// —— 服务端获取 /now 状态数据 ——
interface NowStatus {
  phase: string;
  progress: number;
  badgeText: string;
  updatedAt: string;
}

let status: NowStatus = {
  phase: 'Phase 2',
  progress: 72,
  badgeText: '高投入推进中',
  updatedAt: new Date().toISOString(),
};

try {
  const db = await getDb();
  if (db) {
    const row = await db.prepare("SELECT phase, progress, badge_text, updated_at FROM now_status WHERE id = 1").first();
    if (row) {
      status = { phase: row.phase, progress: row.progress ?? 0, badgeText: row.badge_text || '', updatedAt: row.updated_at };
    }
  }
} catch {}

// —— 服务端获取微日志（与 /now 页面共用同一数据源） ——
interface NowActivityItem {
  id: number;
  content: string;
  activityDate: string;
}

let activities: NowActivityItem[] = [
  { id: 0, content: '完成归档页设计',  activityDate: '04-30' },
  { id: 0, content: '优化首页卡片层级', activityDate: '04-29' },
  { id: 0, content: '构思 /now 页面结构', activityDate: '04-28' },
  { id: 0, content: '统一配色系统',     activityDate: '04-27' },
];

try {
  const db = await getDb();
  if (db) {
    const { results } = await db.prepare("SELECT id, content, activity_date FROM now_activity ORDER BY activity_date DESC, id DESC").all();
    if (results && results.length > 0) {
      activities = results.map((r: any) => ({ id: r.id, content: r.content, activityDate: r.activity_date }));
    }
  }
} catch {}

const phaseLabel = status.phase || 'Phase 2';
const statusLabel = status.badgeText || '平滑推进中';

// 格式化 updatedAt
const updatedAtObj = new Date(status.updatedAt);
const lastBuildStr = isNaN(updatedAtObj.getTime())
  ? '—'
  : `${updatedAtObj.getFullYear()}-${String(updatedAtObj.getMonth()+1).padStart(2,'0')}-${String(updatedAtObj.getDate()).padStart(2,'0')} ${String(updatedAtObj.getHours()).padStart(2,'0')}:${String(updatedAtObj.getMinutes()).padStart(2,'0')}`;

// 计算相对时间
function relativeTime(iso: string): string {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '—';
  const now = Date.now();
  const diff = now - d.getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return '刚刚';
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}
const lastBuildRelative = relativeTime(status.updatedAt);
---

<BaseLayout title="/colophon — 站点说明">
	<!-- 整体容器：双栏布局 -->
	<div class="max-w-[1600px] w-full mx-auto px-6 md:px-10 lg:px-16 py-16 relative flex gap-12 lg:gap-24 xl:gap-32">
		<!-- 左侧：加入 id 与平滑过渡，用于 Final 区域的淡出动画 -->
  		<aside id="colophon-aside" class="hidden md:block w-[200px] shrink-0 self-start sticky top-[50vh] -translate-y-1/2 transition-opacity duration-700 ease-in-out z-50">
  			<nav id="colophon-nav" class="relative w-full pl-4 py-2">
  				<!-- 1. 全局统一的浅色轨道底线 -->
  				<div class="absolute left-0 top-0 bottom-0 w-[1px] bg-[#E0E0E0] dark:bg-[#2A2A2A]"></div>
  				
  				<!-- 2. 滑动的高亮指示条（紫色的胶囊）: 使用 cubic-bezier 模拟苹果物理阻尼感 -->
  				<div id="nav-indicator" class="absolute left-[-1px] top-0 w-[3px] h-[16px] bg-[#8B7CB3] rounded-full transition-transform duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] opacity-0"></div>
  
  				<!-- 3. 导航项容器：去除子层级的边框，纯靠缩进排版 -->
  				<div class="space-y-6 relative z-10">
  					<div>
  						<button data-target="spirit" class="nav-jump w-full text-left text-xs font-bold text-[#999] dark:text-[#666] tracking-widest uppercase mb-3 hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Spirit</button>
  						<div class="space-y-3 mt-2 pl-3">
   							<button data-target="naming" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">贝谟拉比</button>
  							<button data-target="why" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Why</button>
  						</div>
  					</div>
  					<div>
  						<button data-target="system" class="nav-jump w-full text-left text-xs font-bold text-[#999] dark:text-[#666] tracking-widest uppercase mb-3 hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">System</button>
  						<div class="space-y-3 mt-2 pl-3">
  							<button data-target="site-info" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Site Info</button>
  							<button data-target="stack" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Stack</button>
  							<button data-target="architecture" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Architecture</button>
  							<!-- 补充缺失的项 -->
  							<button data-target="design-system" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Design System</button>
  							<button data-target="workflow" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Workflow</button>
  							<button data-target="pipeline" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Build Pipeline</button>
  							<button data-target="roadmap" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Roadmap</button>
  							<button data-target="data-layer" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Data Layer</button>
  							<button data-target="privacy" class="nav-jump w-full text-left text-xs text-[#666] dark:text-[#999] hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Privacy & License</button>
  						</div>
  					</div>
  					<!-- 补充 Credits 项 -->
  					<div>
  						<button data-target="credits" class="nav-jump w-full text-left text-xs font-bold text-[#999] dark:text-[#666] tracking-widest uppercase mb-3 hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">Credits</button>
  					</div>
  					<div>
  						<button data-target="final" class="nav-jump w-full text-left text-xs font-bold text-[#999] dark:text-[#666] tracking-widest uppercase hover:text-[#8B7CB3] dark:hover:text-[#8B7CB3] transition-colors cursor-pointer bg-transparent border-none p-0">End</button>
  					</div>
  				</div>
  			</nav>
 		</aside>

		<!-- 右侧：主内容区 -->
		<main class="flex-1 min-w-0">
			<!-- ==================== 1. 首屏 Hero ==================== -->
			<section id="hero" class="py-24 min-h-[70vh] flex items-center relative overflow-hidden" data-animate>
				<!-- 极简底纹：微弱的制图网格 -->
				<div class="absolute inset-0 bg-[linear-gradient(to_right,#8B7CB315_1px,transparent_1px),linear-gradient(to_bottom,#8B7CB315_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_50%,#000_20%,transparent_100%)] pointer-events-none z-0"></div>

				<div class="relative z-10 max-w-[1000px]">
					<!-- 打字机特效容器 -->
					<div class="inline-flex items-center mb-6 h-[4rem] md:h-[6rem]">
						<h1 id="typewriter-text" class="font-xiaolai text-5xl md:text-7xl font-bold tracking-tight text-[#1A1A1A] dark:text-[#EAEAEA]"></h1>
						<!-- 闪烁的光标 -->
						<span class="inline-block w-[3px] h-[3rem] md:h-[4.5rem] bg-[#8B7CB3] ml-1 animate-pulse"></span>
					</div>

					<!-- 文案：使用纯 Tailwind 过渡，JS 会负责移除透明度 -->
					<p class="hero-fade-text opacity-0 translate-y-4 transition-all duration-1000 ease-out text-lg md:text-xl text-[#666] dark:text-[#999] mb-12 font-light">
						关于这个站点如何被建造。Code, Design, Process, Intention.
					</p>
					<p class="hero-fade-text opacity-0 translate-y-4 transition-all duration-1000 ease-out delay-300 text-2xl md:text-3xl font-light text-[#1A1A1A] dark:text-[#EAEAEA] leading-relaxed tracking-wide">
						世界正在变快、变碎、变短；<br />
						而我走得很慢。
					</p>
				</div>
			</section>

			<!-- ==================== 2. 文学感区 Spirit ==================== -->
			<section id="spirit" class="py-12 md:py-16" data-animate>
				
				<!-- 2.1 贝谟拉比 Naming -->
				<div id="naming" class="py-8">
					<!-- 使用 max-content 完美收缩左侧标题容器，将所有剩余空间 (1fr) 让给右侧 -->
					<div class="grid md:grid-cols-[max-content_1fr] gap-8 lg:gap-16 items-start">
						<!-- 左侧：大标题 -->
						<div>
							<h2 class="font-xiaolai text-4xl md:text-5xl font-bold tracking-tight text-[#1A1A1A] dark:text-[#EAEAEA]">
								贝谟拉比
							</h2>
						</div>

						<!-- 右侧：正文段落 (保持右对齐，加入悬浮变色过渡) -->
						<div class="ml-auto max-w-[800px] space-y-6 text-base md:text-lg text-[#444] dark:text-[#AAA] leading-[1.8] md:text-right">
							<p class="transition-colors duration-300 hover:text-[#8B7CB3] dark:hover:text-[#E8913A]">
								游戏与历史交汇。
							</p>
							<p class="transition-colors duration-300 hover:text-[#8B7CB3] dark:hover:text-[#E8913A]">
								「贝」字源自《崩坏三》的贝拉（贝贝龙），拿出来用到现在。<br />
								「谟拉比」取自汉谟拉比法典——借用可在玄武岩上的秩序。
							</p>
							<p class="transition-colors duration-300 hover:text-[#8B7CB3] dark:hover:text-[#E8913A]">
								于是有了贝谟拉比：<br />
								既严肃，又发癫。
							</p>
						</div>
					</div>
				</div>

				<!-- 2.2 Why This Site Exists -->
				<div id="why" class="py-12 mt-4 md:mt-8" data-animate>
					<div class="max-w-[1000px] space-y-8 text-lg md:text-xl text-[#444] dark:text-[#AAA] leading-[1.8]">
						<p class="transition-colors duration-300 hover:text-[#8B7CB3] dark:hover:text-[#E8913A]">
							我想歇一歇，想记录，想分享，想保留一个属于自己的缓慢空间，<br />
							记录思考、兴趣、作品与阶段性痕迹。
						</p>
						<p class="transition-colors duration-300 hover:text-[#8B7CB3] dark:hover:text-[#E8913A]">
							这里不是社交媒体，<br />
							也不是内容工厂。
						</p>
						<p class="font-medium text-[#1A1A1A] dark:text-[#EAEAEA] transition-colors duration-300 hover:text-[#8B7CB3] dark:hover:text-[#E8913A]">
							这里只是我的站点。
						</p>
					</div>
				</div>
			</section>

			<!-- ==================== 3. 过渡区 Divider ==================== -->
			<div id="divider" class="py-16 my-[120px] flex flex-col items-center text-center">
				<div class="w-24 h-px bg-[#CCC] dark:bg-[#444] mb-6"></div>
				<p class="text-xs text-[#999] dark:text-[#666] tracking-widest uppercase mb-2 font-medium">From Meaning to Mechanism</p>
				<p class="text-xs text-[#999] dark:text-[#666] tracking-widest mb-6 font-medium">以下是它的实现方式</p>
				<div class="w-24 h-px bg-[#CCC] dark:bg-[#444]"></div>
			</div>

			<!-- ==================== 4. 技术感区 System ==================== -->
			<section id="system" class="py-24">
				<!-- 4.1 Site Info + Status -->
				<div id="site-info" class="py-12">
					<h3 class="font-xiaolai text-lg font-bold text-[#1A1A1A] dark:text-[#EAEAEA] mb-2 tracking-tight">Site Info</h3>
					<p class="text-sm text-[#666] dark:text-[#999] mb-10">站点档案 × 实时心跳</p>

					<div class="grid md:grid-cols-2 gap-6">

						<!-- 左：Site Information（紫 · 档案） -->
						<div class="group relative bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md rounded-[2rem] p-8 border border-white/20 dark:border-white/10 shadow-sm hover:-translate-y-1.5 hover:shadow-[0_10px_32px_-8px_rgba(139,124,179,.28)] hover:border-[#8B7CB3]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden" data-animate>
							<svg class="absolute -right-3 -bottom-3 w-28 h-28 text-[#8B7CB3] opacity-[0.05] dark:opacity-[0.08] blur-[2px] group-hover:opacity-[0.14] group-hover:blur-md group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none select-none z-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
							<div class="relative z-10">
								<p class="text-[10px] font-bold text-[#999] tracking-widest uppercase mb-1.5 group-hover:text-[#8B7CB3] transition-colors duration-500">Archive</p>
								<h4 class="font-xiaolai text-lg font-bold text-[#1A1A1A] dark:text-[#EAEAEA] tracking-tight">Site Information</h4>
								<span class="block h-0.5 w-8 mt-2 mb-6 rounded-full bg-gradient-to-r from-[#8B7CB3] to-transparent group-hover:w-14 transition-all duration-500"></span>
								<ul class="space-y-2 text-sm text-[#666] dark:text-[#999]">
									<li class="flex justify-between items-center border-b border-[#E8E8E8]/50 dark:border-[#2A2A2A]/50 pb-2 px-2 -mx-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300">
										<span>上线时间</span>
										<span class="text-[#1A1A1A] dark:text-[#EAEAEA] font-mono font-medium">{SITE_CONFIG.siteStartDate}</span>
									</li>
									<li class="flex justify-between items-center border-b border-[#E8E8E8]/50 dark:border-[#2A2A2A]/50 pb-2 px-2 -mx-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300">
										<span>当前阶段</span>
										<span class="text-[#1A1A1A] dark:text-[#EAEAEA] font-medium">{phaseLabel}（{statusLabel}）</span>
									</li>
									<li class="flex justify-between items-center border-b border-[#E8E8E8]/50 dark:border-[#2A2A2A]/50 pb-2 px-2 -mx-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300">
										<span>最后构建</span>
										<span class="text-[#1A1A1A] dark:text-[#EAEAEA] font-mono font-medium">{lastBuildStr}</span>
									</li>
									<li class="flex justify-between items-center pt-1 px-2 -mx-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300">
										<span>开源许可</span>
										<span class="text-[#1A1A1A] dark:text-[#EAEAEA] font-mono font-medium text-right">MIT / CC BY-NC 4.0</span>
									</li>
								</ul>
							</div>
						</div>

						<!-- 右：High Momentum（薄荷 · 心跳） -->
						<div class="group relative bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md rounded-[2rem] p-8 border border-white/20 dark:border-white/10 shadow-sm hover:-translate-y-1.5 hover:shadow-[0_10px_32px_-8px_rgba(124,179,139,.25)] hover:border-[#7CB38B]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden" data-animate>
							<!-- 角落薄荷光晕 -->
							<div class="absolute top-0 right-0 w-32 h-32 bg-[#7CB38B]/10 dark:bg-[#7CB38B]/20 rounded-full blur-3xl pointer-events-none opacity-50 group-hover:opacity-100 transition-opacity duration-500 z-0"></div>
							<svg class="absolute -right-3 -bottom-3 w-28 h-28 text-[#7CB38B] opacity-[0.05] dark:opacity-[0.08] blur-[2px] group-hover:opacity-[0.14] group-hover:blur-md group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none select-none z-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
							<div class="relative z-10">
								<div class="flex items-center justify-between mb-1.5">
									<p class="text-[10px] font-bold text-[#999] tracking-widest uppercase group-hover:text-[#7CB38B] transition-colors duration-500">Live Status</p>
									<div class="flex items-center gap-2">
										<span class="relative flex h-3 w-3">
											<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#7CB38B] opacity-75"></span>
											<span class="relative inline-flex rounded-full h-3 w-3 bg-[#7CB38B]"></span>
										</span>
										<span class="text-[10px] font-bold text-[#7CB38B] tracking-widest uppercase">High Momentum</span>
									</div>
								</div>
								<h4 class="font-xiaolai text-4xl font-bold text-[#1A1A1A] dark:text-[#EAEAEA] mb-1 tracking-tight group-hover:text-[#7CB38B] transition-colors duration-500">{phaseLabel}</h4>
								<span class="block h-0.5 w-8 mt-2 mb-4 rounded-full bg-gradient-to-r from-[#7CB38B] to-transparent group-hover:w-14 transition-all duration-500"></span>
								<p class="text-sm text-[#666] dark:text-[#999] mb-6">{statusLabel}</p>

								<!-- 进度条：DB 里的 progress 值首次可视化 -->
								<div class="mb-5">
									<div class="flex justify-between items-end mb-1.5">
										<span class="text-[10px] font-bold text-[#999] tracking-widest uppercase">Progress</span>
										<span class="font-mono text-sm font-bold text-[#7CB38B]">{status.progress}%</span>
									</div>
									<div class="h-2 rounded-full bg-black/5 dark:bg-white/10 overflow-hidden">
										<div class="h-full rounded-full bg-gradient-to-r from-[#7CB38B] to-[#8B7CB3] relative overflow-hidden transition-[width] duration-1000 ease-out" style={`width: ${status.progress}%`}>
											<div class="absolute inset-0 colo-shimmer"></div>
										</div>
									</div>
								</div>

								<div class="flex items-center gap-2 text-xs text-[#999] dark:text-[#666]">
									<svg class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
									</svg>
									<span class="font-mono">Last Build: {lastBuildRelative}</span>
								</div>
							</div>
						</div>

					</div>
				</div>


				<!-- 4.2 Stack -->
				<div id="stack" class="py-12">
					<h3 class="font-xiaolai text-lg font-bold text-[#1A1A1A] dark:text-[#EAEAEA] mb-2 tracking-tight">Stack</h3>
					<p class="text-sm text-[#666] dark:text-[#999] mb-10">从框架到 AI · 八件趁手工具</p>

					<div class="grid grid-cols-2 md:grid-cols-4 gap-4">

