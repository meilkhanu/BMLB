---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDb } from '../lib/db';
import { getAboutConfig, getAboutSkills, getAboutWorks, getAboutLinks } from '../lib/about';

const db = await getDb();

const [config, skills, works, links] = await Promise.all([
  getAboutConfig(db),
  getAboutSkills(db),
  getAboutWorks(db),
  getAboutLinks(db),
]);

const isEmpty = skills.length === 0 && works.length === 0;

// —— 软件 → 主题色映射（作品卡首标签 = 主力工具，认领自己的颜色）——
const TOOL_COLORS: [string, string][] = [
  ['grasshopper', '#7CB38B'],
  ['rhino', '#7BA3D9'],
  ['solidworks', '#8B7CB3'],
  ['fusion', '#FF6B9D'],
  ['blender', '#FF6B9D'],
  ['cad', '#8B7CB3'],
  ['parametric', '#7CB38B'],
];
function toolColor(tag: string): string {
  const k = (tag || '').toLowerCase();
  for (const [key, c] of TOOL_COLORS) if (k.includes(key)) return c;
  return '#8B7CB3';
}

// —— 技能胶囊四色轮换（完整字面量，Tailwind 可扫描）——
const PILL_STYLES = [
  'border-[#8B7CB3]/25 text-[#8B7CB3] hover:bg-[#8B7CB3]/10 hover:border-[#8B7CB3]/50',
  'border-[#FF6B9D]/25 text-[#FF6B9D] hover:bg-[#FF6B9D]/10 hover:border-[#FF6B9D]/50',
  'border-[#7CB38B]/25 text-[#7CB38B] hover:bg-[#7CB38B]/10 hover:border-[#7CB38B]/50',
  'border-[#7BA3D9]/25 text-[#7BA3D9] hover:bg-[#7BA3D9]/10 hover:border-[#7BA3D9]/50',
];

// —— CTA 链接交替色 ——
const LINK_ACCENTS = ['#8B7CB3', '#FF6B9D'];
---

<BaseLayout title={config.breadcrumbSub}>
  <main class="bg-[#FAFAFA] dark:bg-[#0F0F0F] text-[#1A1A1A] dark:text-[#EAEAEA]">

    <!-- ================= HERO ================= -->
    <section class="relative h-[70vh] overflow-hidden">
      <img
        src={config.heroImage}
        class="absolute inset-0 w-full h-full object-cover"
        style={`object-position: ${config.aboutHeroPosition}`}
        alt="about hero"
      />

      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/60"></div>

      <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-6">
        <h1 class="font-xiaolai text-4xl md:text-6xl font-semibold tracking-tight">
          About
        </h1>
        <p class="mt-4 text-sm md:text-base text-white/80">
          {config.heroSubtitle}
        </p>
      </div>

      <!-- 下滑提示：轻盈的呼吸箭头 -->
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 animate-bounce text-white/60">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
      </div>
    </section>

    <!-- ================= BREADCRUMB ================= -->
    <section class="max-w-6xl mx-auto px-6 -mt-10" data-animate>
      <div class="group rounded-[2rem] bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md border border-white/20 dark:border-white/10 p-5 shadow-sm hover:shadow-[0_10px_32px_-8px_rgba(139,124,179,.28)] hover:border-[#8B7CB3]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
        <div class="flex items-center gap-4">
          <img
            src={config.avatar}
            alt="avatar"
            class="w-14 h-14 rounded-2xl object-cover ring-2 ring-white/60 dark:ring-white/10 shadow-sm group-hover:scale-105 group-hover:rotate-1 transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
          />
          <div class="min-w-0">
            <div class="text-xs text-[#999] dark:text-[#666] tracking-wide">
              Home <span class="text-[#8B7CB3] mx-1">/</span> About
            </div>
            <div class="mt-1 font-xiaolai text-xl font-bold text-[#1A1A1A] dark:text-[#EAEAEA] tracking-tight">
              {config.breadcrumbSub}
            </div>
          </div>
        </div>
      </div>
    </section>

    {isEmpty ? (
      <!-- ================= EMPTY STATE ================= -->
      <section class="max-w-6xl mx-auto px-6 mt-14 mb-20 text-center">
        <div class="rounded-[2rem] bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md border border-white/20 dark:border-white/10 p-12 shadow-sm">
          <div class="text-[#8B7CB3] text-lg font-medium mb-3">关于页面暂无内容</div>
          <p class="text-sm text-[#666] dark:text-[#999]">
            请在管理后台填充关于页面数据，或执行 seed_about.sql 初始化种子数据。
          </p>
        </div>
      </section>
    ) : (
      <>
        <!-- ================= INTRO + INFO ================= -->
        <section class="max-w-6xl mx-auto px-6 mt-10 grid grid-cols-1 md:grid-cols-3 gap-6">

          <!-- LEFT: INTRO（紫 · 自述） -->
          <div class="group relative md:col-span-2 rounded-[2rem] bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md border border-white/20 dark:border-white/10 p-7 shadow-sm hover:-translate-y-1.5 hover:shadow-[0_10px_32px_-8px_rgba(139,124,179,.28)] hover:border-[#8B7CB3]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden" data-animate>
            <!-- 幽灵图标：自述 -->
            <svg class="absolute -right-3 -bottom-3 w-28 h-28 text-[#8B7CB3] opacity-[0.05] dark:opacity-[0.08] blur-[2px] group-hover:opacity-[0.14] group-hover:blur-md group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none select-none z-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>

            <div class="relative z-10">
              <p class="text-[10px] font-bold text-[#999] tracking-widest uppercase mb-1.5 group-hover:text-[#8B7CB3] transition-colors duration-500">Introduction</p>
              <h2 class="font-xiaolai text-lg font-bold text-[#1A1A1A] dark:text-[#EAEAEA] tracking-tight">{config.introTitle}</h2>
              <span class="block h-0.5 w-8 mt-2 mb-5 rounded-full bg-gradient-to-r from-[#8B7CB3] to-transparent group-hover:w-14 transition-all duration-500"></span>

              <div class="space-y-4 text-[15px] leading-[1.9] text-[#666] dark:text-[#999]">
                {config.introParagraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          </div>

          <!-- RIGHT: INFO CARDS -->
          <div class="space-y-4">

            <!-- BASIC INFO（雾蓝 · 档案） -->
            <div class="group relative rounded-[2rem] bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md border border-white/20 dark:border-white/10 p-5 shadow-sm hover:-translate-y-1 hover:shadow-[0_10px_32px_-8px_rgba(123,163,217,.25)] hover:border-[#7BA3D9]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden delay-1" data-animate>
              <svg class="absolute -right-2 -bottom-2 w-16 h-16 text-[#7BA3D9] opacity-[0.06] dark:opacity-[0.1] blur-[2px] group-hover:opacity-[0.16] group-hover:blur-md group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none select-none z-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z"/></svg>

              <div class="relative z-10">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#7BA3D9] shadow-[0_0_6px_#7BA3D9]"></span>
                  <div class="text-sm font-bold text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#7BA3D9] transition-colors duration-500">{config.basicTitle}</div>
                </div>
                <span class="block h-0.5 w-6 mt-2 mb-3 rounded-full bg-gradient-to-r from-[#7BA3D9] to-transparent group-hover:w-10 transition-all duration-500"></span>

                <div class="space-y-1 text-sm">
                  {config.basicItems.map((item) => (
                    <div class="flex justify-between items-center gap-3 px-2 -mx-2 py-1 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300">
                      <span class="text-xs text-[#999] dark:text-[#666] tracking-wide shrink-0">{item.label}</span>
                      <span class="font-medium text-[#1A1A1A] dark:text-[#EAEAEA] text-right">{item.value}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- SKILLS（粉 · 工具） -->
            <div class="group relative rounded-[2rem] bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md border border-white/20 dark:border-white/10 p-5 shadow-sm hover:-translate-y-1 hover:shadow-[0_10px_32px_-8px_rgba(255,107,157,.25)] hover:border-[#FF6B9D]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden delay-2" data-animate>
              <svg class="absolute -right-2 -bottom-2 w-16 h-16 text-[#FF6B9D] opacity-[0.06] dark:opacity-[0.1] blur-[2px] group-hover:opacity-[0.16] group-hover:blur-md group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none select-none z-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085"/></svg>

              <div class="relative z-10">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#FF6B9D] shadow-[0_0_6px_#FF6B9D]"></span>
                  <div class="text-sm font-bold text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#FF6B9D] transition-colors duration-500">{config.skillsTitle}</div>
                </div>
                <span class="block h-0.5 w-6 mt-2 mb-3 rounded-full bg-gradient-to-r from-[#FF6B9D] to-transparent group-hover:w-10 transition-all duration-500"></span>

                <div class="flex flex-wrap gap-2 text-xs">
                  {skills.map((t, i) => (
                    <span class:list={[
                      "px-2.5 py-1 rounded-full border font-medium transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] hover:-translate-y-0.5 cursor-default",
                      PILL_STYLES[i % PILL_STYLES.length],
                    ]}>
                      {t.name}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- STATUS（薄荷 · 心跳） -->
            <div class="group relative rounded-[2rem] bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md border border-white/20 dark:border-white/10 p-5 shadow-sm hover:-translate-y-1 hover:shadow-[0_10px_32px_-8px_rgba(124,179,139,.25)] hover:border-[#7CB38B]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden delay-3" data-animate>
              <svg class="absolute -right-2 -bottom-2 w-16 h-16 text-[#7CB38B] opacity-[0.06] dark:opacity-[0.1] blur-[2px] group-hover:opacity-[0.16] group-hover:blur-md group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none select-none z-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.348 14.651a3.75 3.75 0 010-5.303m5.304 0a3.75 3.75 0 010 5.303m-7.425 2.122a6.75 6.75 0 010-9.546m9.546 0a6.75 6.75 0 010 9.546M5.106 18.894c-3.808-3.808-3.808-9.98 0-13.789m13.788 0c3.808 3.808 3.808 9.981 0 13.79M12 12h.008v.007H12V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>

              <div class="relative z-10">
                <div class="flex items-center gap-2">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#7CB38B] opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-[#7CB38B]"></span>
                  </span>
                  <div class="text-sm font-bold text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#7CB38B] transition-colors duration-500">{config.statusTitle}</div>
                </div>
                <span class="block h-0.5 w-6 mt-2 mb-3 rounded-full bg-gradient-to-r from-[#7CB38B] to-transparent group-hover:w-10 transition-all duration-500"></span>

                <div class="text-sm leading-relaxed text-[#666] dark:text-[#999]">
                  {config.statusText}
                </div>
              </div>
            </div>

          </div>
        </section>

        <!-- ================= WORKS ================= -->
        <section class="max-w-6xl mx-auto px-6 mt-16">
          <!-- 区块头：标签语言 + 渐变线 + 项目计数 -->
          <div class="flex items-center gap-5 mb-8" data-animate>
            <div class="shrink-0">
              <p class="text-[10px] font-bold text-[#999] tracking-widest uppercase mb-1">Portfolio</p>
              <h2 class="font-xiaolai text-xl font-bold text-[#1A1A1A] dark:text-[#EAEAEA] tracking-tight">Works / CAD & Modeling</h2>
            </div>
            <span class="flex-1 h-0.5 rounded-full bg-gradient-to-r from-[#8B7CB3]/40 via-[#FF6B9D]/25 to-transparent"></span>
            <span class="shrink-0 font-mono text-xs font-bold text-[#8B7CB3] bg-[#8B7CB3]/10 px-2.5 py-1 rounded-full">{works.length} 项目</span>
          </div>

          <div class="space-y-6">

            {works.map((w, i) => {
              const num = String(i + 1).padStart(2, '0');
              const [tool, ...restTags] = w.tags;
              const toolHex = tool ? toolColor(tool) : '#8B7CB3';
              return (
                <a
                  href={w.slug ? `/work/${w.slug}` : undefined}
                  class:list={[
                    "group relative block rounded-[2rem] bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md border border-white/20 dark:border-white/10 p-5 shadow-sm hover:-translate-y-1.5 hover:shadow-[0_10px_32px_-8px_rgba(139,124,179,.28)] hover:border-[#8B7CB3]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden no-underline text-inherit",
                    w.slug ? "cursor-pointer" : "cursor-default",
                    `delay-${i % 5}`,
                  ]}
                  data-animate
                >
                  <!-- 幽灵序号水印 -->
                  <span class="absolute top-3 right-6 font-xiaolai text-5xl font-bold text-[#8B7CB3] opacity-[0.07] group-hover:opacity-[0.16] transition-opacity duration-500 pointer-events-none select-none z-0">{num}</span>

                  <div class="relative z-10 flex flex-col md:flex-row gap-5">

                    <!-- IMAGE：hover 缩放 + 工具徽章浮于图上 -->
                    <div class="w-full md:w-[280px] shrink-0">
                      <div class="relative rounded-2xl overflow-hidden bg-[#F5F5F5] dark:bg-[#252525] aspect-video md:aspect-[4/3]">
                        {w.image ? (
                          <img
                            src={w.image}
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            alt={w.title}
                          />
                        ) : (
                          <div class="absolute inset-0 flex items-center justify-center text-[#CCC] dark:text-[#444]">
                            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                          </div>
                        )}

                        <!-- 主力工具徽章（首标签，认领工具色） -->
                        {tool && (
                          <span class="absolute bottom-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/85 dark:bg-[#1A1A1A]/80 backdrop-blur-sm shadow-sm text-xs font-bold text-[#1A1A1A] dark:text-[#EAEAEA]">
                            <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${toolHex};box-shadow:0 0 6px ${toolHex}`}></span>
                            {tool}
                          </span>
                        )}

                        <!-- 精选角标 -->
                        {w.featured && (
                          <span class="absolute top-3 right-3 px-2.5 py-1 rounded-lg bg-[#FF6B9D]/90 text-white text-[10px] font-bold tracking-widest shadow-lg">精选</span>
                        )}
                      </div>
                    </div>

                    <!-- TEXT -->
                    <div class="flex-1 flex flex-col justify-center min-w-0 py-1">
                      <div class="flex items-center gap-3 flex-wrap">
                        <h3 class="font-xiaolai text-xl font-bold text-[#1A1A1A] dark:text-[#EAEAEA] leading-snug group-hover:text-[#8B7CB3] transition-colors duration-300">
                          {w.title}
                        </h3>
                        {!w.slug && (
                          <span class="text-[10px] font-bold text-[#999] tracking-widest bg-black/5 dark:bg-white/10 px-2 py-0.5 rounded-full">即将上线</span>
                        )}
                      </div>

                      <p class="mt-2.5 text-sm text-[#666] dark:text-[#999] leading-relaxed line-clamp-2">
                        {w.description}
                      </p>

                      {restTags.length > 0 && (
                        <div class="mt-3.5 flex flex-wrap gap-2 text-xs">
                          {restTags.map((t) => (
                            <span class="px-2.5 py-1 rounded-full border border-white/30 dark:border-white/10 text-[#888] dark:text-[#777] group-hover:border-[#8B7CB3]/25 group-hover:text-[#8B7CB3] transition-all duration-300">
                              {t}
                            </span>
                          ))}
                        </div>
                      )}

                      {w.slug && (
                        <div class="mt-4 flex items-center text-[#8B7CB3] text-sm font-bold opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                          查看项目
                          <svg class="w-4 h-4 ml-1 mt-[1px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                        </div>
                      )}
                    </div>

                  </div>
                </a>
              );
            })}

          </div>
        </section>

        <!-- ================= CTA LINKS ================= -->
        <section class="max-w-6xl mx-auto px-6 mt-16">
          <div class="flex items-center gap-5 mb-8" data-animate>
            <div class="shrink-0">
              <p class="text-[10px] font-bold text-[#999] tracking-widest uppercase mb-1">Elsewhere</p>
              <h2 class="font-xiaolai text-xl font-bold text-[#1A1A1A] dark:text-[#EAEAEA] tracking-tight">Links</h2>
            </div>
            <span class="flex-1 h-0.5 rounded-full bg-gradient-to-r from-[#FF6B9D]/40 via-[#8B7CB3]/25 to-transparent"></span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {links.map((link, i) => {
              const accent = LINK_ACCENTS[i % LINK_ACCENTS.length];
              // URL 防御：不完整/无效的地址（如只填了 "https://"）不渲染为可点击链接，
              // 避免浏览器导航被拦截显示 about:blank#blocked
              const url = (link.url || '').trim();
              const validUrl = /^(https?:\/\/\S+|\/\S*|#\S*)$/.test(url);
              return (
                <a href={validUrl ? url : undefined}
                   class:list={[
                     "group relative rounded-[2rem] bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md border border-white/20 dark:border-white/10 p-7 shadow-sm overflow-hidden no-underline text-inherit delay-1",
                     validUrl
                       ? "hover:-translate-y-1.5 hover:shadow-[0_10px_32px_-8px_rgba(139,124,179,.28)] hover:border-[#8B7CB3]/30 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
                       : "cursor-default opacity-70",
                   ]}
                   data-animate>
                  <!-- 幽灵图标：外链 -->
                  <svg class="absolute -right-2 -bottom-2 w-20 h-20 text-[#8B7CB3] opacity-[0.05] dark:opacity-[0.08] blur-[2px] group-hover:opacity-[0.14] group-hover:blur-md group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none select-none z-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>

                  <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-1.5">
                      <span class="w-1.5 h-1.5 rounded-full transition-all duration-500" style={`background:${accent}`}></span>
                      <p class="text-[10px] font-bold text-[#999] tracking-widest uppercase group-hover:text-[#8B7CB3] transition-colors duration-500">Link {String(i + 1).padStart(2, '0')}</p>
                    </div>
                    <div class="font-xiaolai text-lg font-bold text-[#1A1A1A] dark:text-[#EAEAEA] tracking-tight group-hover:text-[#8B7CB3] transition-colors duration-300">{link.title}</div>
                    <span class="block h-0.5 w-8 mt-2 mb-3 rounded-full bg-gradient-to-r from-[#8B7CB3] to-transparent group-hover:w-14 transition-all duration-500"></span>
                    <div class="text-sm text-[#666] dark:text-[#999] leading-relaxed">
                      {link.description}
                    </div>

                    <div class="mt-4 flex items-center text-sm font-bold text-[#8B7CB3]">
                      {link.actionText}
                      <svg class="w-4 h-4 ml-1 transition-transform duration-300 group-hover:translate-x-1.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>

        <!-- ================= ALT SYSTEM（建设中） ================= -->
        <section class="max-w-6xl mx-auto px-6 mt-16 mb-20" data-animate>
          <div class="group relative rounded-[2rem] bg-white/40 dark:bg-[#1A1A1A]/40 backdrop-blur-md border border-dashed border-[#8B7CB3]/25 dark:border-[#8B7CB3]/20 p-6 opacity-75 hover:opacity-100 hover:-translate-y-1 hover:border-[#8B7CB3]/40 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] overflow-hidden">
            <!-- 幽灵图标：星火 -->
            <svg class="absolute -right-2 -bottom-2 w-20 h-20 text-[#FF6B9D] opacity-[0.05] dark:opacity-[0.08] blur-[2px] group-hover:opacity-[0.14] group-hover:blur-md group-hover:scale-125 transition-all duration-700 ease-out pointer-events-none select-none z-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9.375 17.25l-.438-1.346a4.5 4.5 0 00-2.841-2.841L4.75 12.625l1.346-.438a4.5 4.5 0 002.841-2.841L9.375 8l.438 1.346a4.5 4.5 0 002.841 2.841l1.346.438-1.346.438a4.5 4.5 0 00-2.841 2.841zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/></svg>

            <div class="relative z-10 flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2.5">
                  <div class="font-xiaolai text-sm font-bold text-[#8B7CB3] tracking-tight">
                    {config.altTitle}
                  </div>
                  <span class="flex items-center gap-1.5 text-[10px] font-bold text-[#7CB38B] tracking-widest bg-[#7CB38B]/10 px-2 py-0.5 rounded-full">
                    <span class="relative flex h-1.5 w-1.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#7CB38B] opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#7CB38B]"></span>
                    </span>
                    建设中
                  </span>
                </div>
                <div class="mt-2 text-sm text-[#666] dark:text-[#999]">
                  {config.altDescription}
                </div>
              </div>
            </div>
          </div>
        </section>
      </>
    )}

  </main>
</BaseLayout>
