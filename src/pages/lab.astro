---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDb } from "../lib/db";
import { getLabApps, LAB_CATEGORIES, categoryLabel } from "../lib/lab";

const db = await getDb();
const apps = await getLabApps(db);

// 单色 accent（科技感：一页一个强调色，不做多彩轮换）
const ACCENT = "#22D3EE";
const ACCENT_SOFT = "rgba(34,211,238,.35)";
---

<BaseLayout title="实验室 — 贝谟拉比">
  <main class="bg-[#FAFAFA] dark:bg-[#0A0A0F] text-[#1A1A1A] dark:text-[#EAEAEA] min-h-screen pt-24 pb-20 lab-grid-bg">
    <div class="max-w-5xl mx-auto px-6">

      <!-- ================= 页头 ================= -->
      <section class="mb-10" data-animate>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-1.5 h-1.5 rounded-full" style={`background:${ACCENT}`}></span>
          <p class="font-mono text-[10px] font-bold tracking-widest uppercase text-[#999] dark:text-[#666]">~/lab</p>
        </div>
        <h1 class="font-mono text-3xl font-bold tracking-tight">实验室</h1>
        <p class="mt-3 font-mono text-xs text-[#666] dark:text-[#999]">
          <span class="text-[#999] dark:text-[#666]">$</span>
          experiments --list
          <span class="text-[#999] dark:text-[#666]">·</span>
          {apps.length} item{apps.length === 1 ? "" : "s"}
        </p>
        <p class="mt-3 text-sm text-[#666] dark:text-[#999]">
          实验性工具与原型，可能不稳定。
        </p>
      </section>

      <!-- ================= 分类筛选（segmented 下划线） ================= -->
      {apps.length > 0 && (
        <div class="flex gap-6 mb-8 border-b border-black/10 dark:border-white/10" data-animate>
          {LAB_CATEGORIES.map((cat, i) => (
            <button
              class="lab-cat-btn font-mono text-xs font-bold pb-2.5 border-b -mb-px text-[#999] dark:text-[#666] border-transparent hover:text-[#1A1A1A] dark:hover:text-[#EAEAEA] transition-colors duration-200 cursor-pointer bg-transparent"
              data-cat={cat.id}
              style={`animation-delay:${0.05 * i}s`}
            >
              {cat.label}
            </button>
          ))}
        </div>
      )}

      <!-- ================= 卡片网格 ================= -->
      {apps.length === 0 ? (
        <!-- 空状态：终端窗口 -->
        <section class="max-w-xl mx-auto rounded-lg border border-black/10 dark:border-white/10 bg-white dark:bg-[#0D1117] overflow-hidden shadow-sm" data-animate>
          <!-- 标题栏 -->
          <div class="flex items-center gap-2 px-4 py-2.5 border-b border-black/[0.07] dark:border-white/[0.07]">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
            <span class="ml-2 font-mono text-[10px] text-[#999] dark:text-[#666]">/lab</span>
          </div>
          <!-- 终端内容 -->
          <div class="p-6 font-mono text-xs leading-relaxed">
            <p class="text-[#666] dark:text-[#999]"><span style={`color:${ACCENT}`}>$</span> ./experiments --status</p>
            <p class="mt-4 text-[#1A1A1A] dark:text-[#EAEAEA]">No experiments yet.</p>
            <p class="mt-1 text-[#666] dark:text-[#999]">
              Build in progress<span class="inline-block w-[7px] h-[13px] align-[-2px] ml-0.5 lab-cursor" style={`background:${ACCENT}`}></span>
            </p>
            <p class="mt-5 text-[#999] dark:text-[#666]">
              <span style={`color:${ACCENT}`}>→</span> 正在酝酿第一个实验，敬请期待。
            </p>
            <p class="mt-4 text-[#999] dark:text-[#666] opacity-60">
              <span style={`color:${ACCENT}`}>→</span> 用管理后台添加实验，或手动 INSERT 到 lab_apps 表。
            </p>
          </div>
        </section>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="lab-grid">
          {apps.map((app, i) => {
            const isExternal = /^https?:\/\//.test(app.path);
            return (
              <a
                href={app.path}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                data-cat={app.category}
                class="group lab-card relative rounded-lg bg-white dark:bg-[#0D1117] border border-black/10 dark:border-white/10 p-5 no-underline text-inherit transition-[border-color,box-shadow] duration-200 hover:border-[#22D3EE]/40 hover:shadow-[0_0_0_1px_rgba(34,211,238,.15)]"
                data-animate
              >
                <!-- 顶部：序号 + 分类标签 -->
                <div class="flex items-center justify-between mb-4">
                  <span class="font-mono text-[10px] font-bold text-[#999] dark:text-[#666]">{String(i + 1).padStart(2, '0')}</span>
                  <span class="font-mono text-[10px] font-bold text-[#999] dark:text-[#666] tracking-wider uppercase">{categoryLabel(app.category)}</span>
                </div>

                <!-- 标题 -->
                <div class="flex items-center gap-2.5">
                  <span class="w-8 h-8 rounded-md flex items-center justify-center text-base border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/5 text-[#1A1A1A] dark:text-[#EAEAEA]">
                    {app.icon || '◈'}
                  </span>
                  <h3 class="text-base font-bold text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#22D3EE] transition-colors duration-200">
                    {app.title}
                  </h3>
                </div>

                <!-- 描述 -->
                <p class="mt-3 text-sm text-[#666] dark:text-[#999] leading-relaxed line-clamp-2">
                  {app.description}
                </p>

                <!-- 底部 meta -->
                <div class="mt-4 pt-3 border-t border-black/[0.06] dark:border-white/[0.06] flex items-center justify-between font-mono text-[10px] text-[#999] dark:text-[#666]">
                  <span>{categoryLabel(app.category)}</span>
                  <span class="transition-transform duration-200 group-hover:translate-x-1" style={`color:${ACCENT}`}>→</span>
                </div>
              </a>
            );
          })}
        </div>
      )}

    </div>
  </main>

  <script is:inline>
    // 分类筛选（纯前端，无 JS 框架）
    (function () {
      const btns = document.querySelectorAll('.lab-cat-btn');
      const cards = document.querySelectorAll('.lab-card');
      const activate = (btn) => {
        btns.forEach(b => {
          const on = b === btn;
          b.classList.toggle('lab-cat-active', on);
          b.style.color = on ? '#22D3EE' : '';
          b.style.borderBottomColor = on ? '#22D3EE' : 'transparent';
        });
      };
      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.dataset.cat;
          activate(btn);
          cards.forEach(card => {
            const show = cat === 'all' || card.dataset.cat === cat;
            card.style.display = show ? '' : 'none';
          });
        });
      });
      // 初始高亮"全部"
      if (btns.length) activate(btns[0]);
    })();
  </script>

  <style>
    /* 极淡点阵网格背景 —— 科技感里性价比最高的细节 */
    .lab-grid-bg {
      background-image: radial-gradient(rgba(0, 0, 0, 0.045) 1px, transparent 1px);
      background-size: 22px 22px;
    }
    :root.dark .lab-grid-bg,
    .dark .lab-grid-bg {
      background-image: radial-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    }
    /* 终端光标闪烁 */
    .lab-cursor {
      animation: lab-blink 1.1s steps(2, start) infinite;
    }
    @keyframes lab-blink {
      to { visibility: hidden; }
    }
    /* 卡片入场：只做位移+淡入，不用弹簧 */
    .lab-card[data-animate] { will-change: transform, opacity; }
    /* 覆盖全站弹簧入场动画，改为克制的 ease-out（仅本页） */
    main [data-animate].animate-fade-in-up {
      animation: fadeInUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</BaseLayout>
