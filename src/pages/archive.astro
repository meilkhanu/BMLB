---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config.ts';
import { getDb } from '../lib/db';

// —— 服务端获取全部已发布文章 ——
interface ApiPost {
  id: number;
  slug: string;
  title: string;
  excerpt: string;
  categoryId: string;
  tags: string[];
  coverImage: string;
  publishedAt: string;
  createdAt: string;
  updatedAt: string;
  status: string;
}

let allPosts: ApiPost[] = [];
try {
  const db = await getDb();
  if (db) {
    const { results } = await db.prepare(
      "SELECT id, slug, title, excerpt, category_id, tags, cover_image, published_at, created_at, updated_at, status FROM posts WHERE status = 'published' ORDER BY published_at DESC LIMIT 100"
    ).all();
    allPosts = (results || []).map((row: any) => ({
      id: row.id,
      slug: row.slug,
      title: row.title,
      excerpt: row.excerpt || '',
      categoryId: row.category_id,
      tags: JSON.parse(row.tags || '[]'),
      coverImage: row.cover_image || '',
      publishedAt: row.published_at || '',
      createdAt: row.created_at,
      updatedAt: row.updated_at,
      status: row.status,
    }));
  }
} catch (e: any) {
  console.error('[archive] D1 posts 查询失败:', e?.message || e);
}

// 分类映射
const catMap = Object.fromEntries(
  SITE_CONFIG.categories.map(c => [c.id, { name: c.name, color: c.color }])
);

// 按年月分组
interface MonthGroup {
  month: number;   // 1-12
  label: string;   // "04 月"
  posts: ApiPost[];
}

interface YearGroup {
  year: number;
  months: MonthGroup[];
  total: number;
}

const yearGroups: YearGroup[] = [];
const yearMap = new Map<number, Map<number, ApiPost[]>>();

allPosts.forEach(p => {
  const dateStr = p.publishedAt || p.createdAt;
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return;
  const y = d.getFullYear();
  const m = d.getMonth() + 1;
  if (!yearMap.has(y)) yearMap.set(y, new Map());
  const monthMap = yearMap.get(y)!;
  if (!monthMap.has(m)) monthMap.set(m, []);
  monthMap.get(m)!.push(p);
});

// 按年份降序排
const sortedYears = Array.from(yearMap.keys()).sort((a, b) => b - a);
sortedYears.forEach(y => {
  const monthMap = yearMap.get(y)!;
  const sortedMonths = Array.from(monthMap.keys()).sort((a, b) => b - a);
  const months: MonthGroup[] = sortedMonths.map(m => ({
    month: m,
    label: `${String(m).padStart(2, '0')} 月`,
    posts: monthMap.get(m)!,
  }));
  yearGroups.push({
    year: y,
    months,
    total: months.reduce((sum, mg) => sum + mg.posts.length, 0),
  });
});

// 统计标签（全部文章）
const tagCounts: Record<string, number> = {};
allPosts.forEach(p => {
  (p.tags || []).forEach(t => {
    tagCounts[t] = (tagCounts[t] || 0) + 1;
  });
});
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

// 年度摘要：最高产月份（右侧摘要卡片用）
const latestYearGroup = yearGroups.length > 0 ? yearGroups[0] : null;
const busiestMonth = latestYearGroup && latestYearGroup.months.length > 0
  ? latestYearGroup.months.reduce((a, b) => (b.posts.length > a.posts.length ? b : a), latestYearGroup.months[0])
  : null;

// 年份节点颜色轮换
const yearColors = ['#8B7CB3', '#E8913A', '#4A5D8A', '#7CB38B', '#B38B7C', '#8B8B8B'];
---

<BaseLayout title="归档">
	<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden mix-blend-multiply dark:mix-blend-screen">
		<div class="absolute inset-0 bg-[radial-gradient(#d1d5db_1.5px,transparent_1.5px)] dark:bg-[radial-gradient(#2c2c2c_1.5px,transparent_1.5px)] [background-size:32px_32px] opacity-100"></div>
		
		<div class="absolute inset-0">
			<div class="tech-dot bg-[#39C5BB]" style="left: 8%; bottom: -10px; --delay: 0s; --speed: 9s; --size: 3px;"></div>
			<div class="tech-dot bg-[#FF1A4D]" style="left: 18%; bottom: -10px; --delay: 4s; --speed: 12s; --size: 4px;"></div>
			<div class="tech-dot bg-[#39C5BB]" style="left: 28%; bottom: -10px; --delay: 2s; --speed: 7s; --size: 2px;"></div>
			<div class="tech-dot bg-[#FF1A4D]" style="left: 38%; bottom: -10px; --delay: 6s; --speed: 14s; --size: 3px;"></div>
			
			<div class="tech-dot bg-[#39C5BB]" style="left: 48%; bottom: -10px; --delay: 1.5s; --speed: 10s; --size: 4px;"></div>
			<div class="tech-dot bg-[#FF1A4D]" style="left: 58%; bottom: -10px; --delay: 5.5s; --speed: 8s; --size: 2.5px;"></div>
			<div class="tech-dot bg-[#39C5BB]" style="left: 65%; bottom: -10px; --delay: 3.2s; --speed: 13s; --size: 3px;"></div>
			<div class="tech-dot bg-[#FF1A4D]" style="left: 73%; bottom: -10px; --delay: 0.8s; --speed: 11s; --size: 3.5px;"></div>
			
			<div class="tech-dot bg-[#39C5BB]" style="left: 82%; bottom: -10px; --delay: 7s; --speed: 9.5s; --size: 2px;"></div>
			<div class="tech-dot bg-[#FF1A4D]" style="left: 89%; bottom: -10px; --delay: 2.5s; --speed: 15s; --size: 4px;"></div>
			<div class="tech-dot bg-[#39C5BB]" style="left: 94%; bottom: -10px; --delay: 4.8s; --speed: 7.5s; --size: 3px;"></div>
			<div class="tech-dot bg-[#FF1A4D]" style="left: 97%; bottom: -10px; --delay: 1.2s; --speed: 10.5s; --size: 2px;"></div>
		</div>

		<div class="absolute bottom-16 right-16 opacity-30 dark:opacity-25 transition-all duration-500 hover:opacity-100 hidden lg:block hover:scale-110">
			<svg class="w-20 h-20 animate-mascot-float" viewBox="0 0 100 100">
				<circle cx="50" cy="50" r="42" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3,3" class="text-[#39C5BB]" fill="none" />
				<path d="M32,45 Q40,32 48,45 T64,45" stroke="currentColor" stroke-width="2" fill="none" class="text-[#FF1A4D]" />
				<text x="50" y="65" font-family="monospace" font-size="9" text-anchor="middle" font-weight="bold" class="fill-current text-[#999] dark:text-[#666] tracking-wider">SYS.0104</text>
			</svg>
		</div>
	</div>

	<div class="container mx-auto px-4 py-12 relative z-10 mix-blend-normal">

	<div class="max-w-[1400px] mx-auto px-4 md:px-6 pt-32 pb-12">
		<!-- 标题区 -->
		<div class="mb-12" data-animate>
			<div class="mb-16 ml-2 md:ml-0">
				<h1 class="font-xiaolai text-4xl md:text-5xl font-black text-[#1A1A1A] dark:text-[#EAEAEA] mb-3 tracking-tight">Archive</h1>
				<p class="text-base md:text-lg text-[#666] dark:text-[#999] tracking-wide">过往，现在，未来。因果能否超脱视界？</p>
		</div>

		<!-- 三栏布局 -->
		<div class="grid grid-cols-1 md:grid-cols-[200px_1fr_260px] gap-8">
			
			<!-- 左侧：年份导航（sticky） -->
			<aside class="hidden md:block">
				<div class="sticky top-24">
					<h3 class="text-xs font-medium text-[#999] uppercase tracking-wider mb-4">年份</h3>
					<nav class="flex flex-col gap-2">
						{yearGroups.length > 0 ? yearGroups.map(yg => (
							<a href={`#year-${yg.year}`} class="font-xiaolai text-sm text-[#666] dark:text-[#999] hover:text-[#8B7CB3] hover:translate-x-1 transition-all duration-300">{yg.year}</a>
						)) : (
							<span class="text-sm text-[#999]">暂无</span>
						)}
					</nav>
				</div>
			</aside>

			<!-- 中间：主时间轴 -->
			<main class="relative">
					<!-- 时间轴纵向竖线 -->
				<div class="absolute left-[12px] top-0 bottom-0 w-0 border-l-2 border-dashed border-[#D8D0E8] dark:border-[#2A2540]"></div>

				{yearGroups.length > 0 ? yearGroups.map((yg, yi) => (
					<section id={`year-${yg.year}`} class="relative mb-12" data-animate>
						<!-- 年份大节点 -->
						<div class="sticky top-16 z-20 flex items-center gap-4 py-4 -ml-2 px-2 bg-[#FAFAFA] dark:bg-[#0F0F0F] mb-4 relative transition-colors duration-300">
							<div class="w-6 h-6 rounded-full border-4 border-[#FAFAFA] dark:border-[#0F0F0F] z-10 shadow-[0_0_10px_-2px_rgba(139,124,179,.5)]" style={`background: linear-gradient(135deg, ${yearColors[yi % yearColors.length]}, #FF6B9D)`}></div>
							<h2 class="font-xiaolai text-2xl font-bold">{yg.year}</h2>
							<div class="flex-1 h-[1px] bg-gradient-to-r from-[#8B7CB3]/30 to-transparent"></div>
						</div>

						{yg.months.map(mg => (
							<div class="ml-8 mb-8 relative">
								<h3 class="text-sm font-medium text-[#999] mb-4 relative">
									<span class="absolute left-[-20px] top-[50%] w-4 h-[2px] rounded-full bg-[#E5E5E5] dark:bg-[#222]"></span>
									{mg.label}
								</h3>

								<div class="flex flex-col gap-3">
									{mg.posts.map(p => {
										const cat = catMap[p.categoryId] || { name: p.categoryId, color: '#8B7CB3' };
										const dateStr = p.publishedAt || '';
										const d = new Date(dateStr);
										const mmdd = isNaN(d.getTime()) ? '' : `${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
										return (
											<a href={`/blog/${p.slug}`} class="group relative block bg-white dark:bg-[#252525] rounded-2xl p-4 shadow-sm hover:shadow-[0_6px_20px_-6px_rgba(139,124,179,.3)] hover:-translate-y-0.5 active:scale-[0.99] transition-all duration-300">
												<div class="absolute top-1/2 -translate-y-1/2 left-[-25px] w-2 h-2 rounded-full bg-[#D0C8E0] dark:bg-[#3A3550] group-hover:bg-[#FF6B9D] group-hover:scale-150 transition-all duration-300 ring-4 ring-[#FAFAFA] dark:ring-[#0F0F0F] group-hover:ring-transparent z-10"></div>
												<div class="flex items-center gap-2 mb-2">
													<span class="font-xiaolai px-2.5 py-0.5 rounded-full text-xs font-bold" style={`background-color:${cat.color}18;color:${cat.color}`}>{cat.name}</span>
													<span class="text-xs text-[#999]">{mmdd}</span>
												</div>
												<h4 class="font-xiaolai text-base font-medium text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#8B7CB3] transition-colors">{p.title}</h4>
											</a>
										);
									})}
								</div>
							</div>
						))}
					</section>
				)) : (
					<div class="ml-8 text-sm text-[#999] py-12">暂无已发布文章</div>
				)}
			</main>

			<!-- 右侧：年度摘要卡片 -->
			<aside class="hidden md:block">
				<div class="sticky top-24 space-y-6">
					{latestYearGroup && (
						<div class="group relative overflow-hidden bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md rounded-3xl p-5 border border-white/20 dark:border-white/10 shadow-[0_2px_12px_-4px_rgba(139,124,179,.12)] hover:shadow-[0_8px_28px_-8px_rgba(139,124,179,.3)] transition-shadow duration-500">
							<!-- 角落光晕 -->
							<div class="absolute -top-16 -right-16 w-40 h-40 bg-[#8B7CB3]/10 dark:bg-[#8B7CB3]/20 rounded-full blur-3xl pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity duration-700"></div>
							<div class="flex items-center justify-between mb-5 relative z-10">
								<h3 class="font-xiaolai text-xs font-bold text-[#8B7CB3] uppercase tracking-widest">
									{latestYearGroup.year} Overview
									<span class="block h-0.5 w-8 mt-1 rounded-full bg-gradient-to-r from-[#8B7CB3] to-[#FF6B9D]"></span>
								</h3>
								<span class="relative flex h-2 w-2">
									<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FF6B9D] opacity-75"></span>
									<span class="relative inline-flex rounded-full h-2 w-2 bg-gradient-to-r from-[#8B7CB3] to-[#FF6B9D]"></span>
								</span>
							</div>
							<div class="grid grid-cols-2 gap-3 relative z-10">
								<!-- 已发文章 -->
								<div class="archive-tile" style="animation-delay:.05s">
									<div class="archive-tile-icon bg-[#8B7CB3]/12 dark:bg-[#8B7CB3]/20 text-[#8B7CB3]">📝</div>
									<div class="font-xiaolai text-2xl font-black text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#8B7CB3] transition-colors">{latestYearGroup.total}</div>
									<div class="text-[10px] font-medium text-[#999]">已发文章</div>
								</div>
								<!-- 活跃月份 -->
								<div class="archive-tile" style="animation-delay:.12s">
									<div class="archive-tile-icon bg-[#FF6B9D]/12 dark:bg-[#FF6B9D]/20 text-[#FF6B9D]">📅</div>
									<div class="font-xiaolai text-2xl font-black text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#FF6B9D] transition-colors">{latestYearGroup.months.length}</div>
									<div class="text-[10px] font-medium text-[#999]">活跃月份</div>
								</div>
								<!-- 最高产月 -->
								<div class="archive-tile" style="animation-delay:.19s">
									<div class="archive-tile-icon bg-[#7CB38B]/12 dark:bg-[#7CB38B]/20 text-[#7CB38B]">🌙</div>
									<div class="font-xiaolai text-2xl font-black text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#7CB38B] transition-colors">{busiestMonth ? `${busiestMonth.month}月` : '—'}</div>
									<div class="text-[10px] font-medium text-[#999]">最高产月</div>
								</div>
								<!-- 标签数 -->
								<div class="archive-tile" style="animation-delay:.26s">
									<div class="archive-tile-icon bg-[#7BA3D9]/12 dark:bg-[#7BA3D9]/20 text-[#7BA3D9]">🏷️</div>
									<div class="font-xiaolai text-2xl font-black text-[#1A1A1A] dark:text-[#EAEAEA] group-hover:text-[#7BA3D9] transition-colors">{Object.keys(tagCounts).length}</div>
									<div class="text-[10px] font-medium text-[#999]">标签数</div>
								</div>
							</div>
						</div>
					)}

					{topTags.length > 0 && (
						<div class="group relative overflow-hidden bg-white/60 dark:bg-[#1A1A1A]/60 backdrop-blur-md rounded-3xl p-5 border border-white/20 dark:border-white/10 shadow-[0_2px_12px_-4px_rgba(139,124,179,.12)] hover:shadow-[0_8px_28px_-8px_rgba(139,124,179,.3)] transition-shadow duration-500">
							<div class="absolute -bottom-16 -left-16 w-40 h-40 bg-[#FF6B9D]/8 dark:bg-[#FF6B9D]/15 rounded-full blur-3xl pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity duration-700"></div>
							<h3 class="font-xiaolai text-xs font-bold text-[#8B7CB3] uppercase tracking-widest mb-4 relative z-10">
								Top Tags
								<span class="block h-0.5 w-8 mt-1 rounded-full bg-gradient-to-r from-[#FF6B9D] to-[#8B7CB3]"></span>
							</h3>
							<div class="flex flex-wrap gap-2.5 relative z-10">
								{topTags.map(([tag, count], idx) => (
									<span class="archive-tag-pop font-xiaolai px-3 py-1.5 rounded-full text-xs font-bold bg-[#8B7CB3]/8 dark:bg-[#8B7CB3]/15 text-[#8B7CB3] dark:text-[#B39DDB] border border-[#8B7CB3]/15 dark:border-[#8B7CB3]/25 hover:bg-[#8B7CB3] hover:text-white hover:scale-105 hover:shadow-[0_2px_10px_-2px_rgba(139,124,179,.5)] transition-all duration-300 cursor-default active:scale-95 shadow-sm" style={`animation-delay:${0.05 * idx}s`}>
										{tag} <span class="text-[10px] opacity-50 ml-0.5">{count}</span>
									</span>
								))}
							</div>
						</div>
					)}
				</div>
			</aside>
		</div>

		<!-- 底部年度总结入口（保留） -->
		<div class="mt-20 mb-12 text-center" data-animate>
			<button class="annual-review-btn group">
				<span class="relative z-10 flex items-center justify-center gap-2 font-xiaolai font-bold tracking-wide">
					2026 Review
					<svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
				</span>
			</button>
		</div>
	</div>
</BaseLayout>

<style is:global>
	/* --- 🌐 极简背景与双歌姬联动动效（粒子强化版） --- */

	/* 挂件优雅浮动 */
	@keyframes mascot-floating {
		0%, 100% { transform: translateY(0) rotate(0deg); }
		50% { transform: translateY(-8px) rotate(3deg); }
	}

	/* 电子粒子缓缓上升 */
	@keyframes tech-pixel-up {
		0% {
			transform: translateY(0) scale(1);
			opacity: 0;
		}
		10% { opacity: 0.6; }
		80% { opacity: 0.4; }
		100% {
			transform: translateY(-105vh) scale(0.5);
			opacity: 0;
		}
	}

	.animate-mascot-float {
		animation: mascot-floating 5s ease-in-out infinite;
	}

	/* 粒子属性 */
	.tech-dot {
		position: absolute;
		width: var(--size);
		height: var(--size);
		border-radius: 50%;
		opacity: 0;
		animation: tech-pixel-up var(--speed) linear infinite;
		animation-delay: var(--delay);
		filter: drop-shadow(0 0 4px currentColor);
	}

	/* Apple 图层感知优化：带有高斯模糊的毛玻璃卡片 */
	.group.bg-white {
		backdrop-filter: blur(16px) saturate(120%) !important;
		background-color: rgba(255, 255, 255, 0.75) !important;
	}
	.dark .group.bg-white, .dark .bg-\[\#1A1A1A\] {
		backdrop-filter: blur(16px) saturate(120%) !important;
		background-color: rgba(26, 26, 26, 0.7) !important;
	}

	/* 让主轴上的文章列表卡片也自然穿透透光 */
	a.group.bg-white {
		background-color: rgba(255, 255, 255, 0.7) !important;
	}
	.dark a.group.bg-white, .dark main [class*="bg-[#252525]"] {
		background-color: rgba(37, 37, 37, 0.6) !important;
		backdrop-filter: blur(10px) !important;
	}

	/* --- 🍬 年度摘要软砖（拟态凸面 + Q弹 squish） --- */
	.archive-tile {
		padding: 14px 10px;
		border-radius: 18px;
		text-align: center;
		background: linear-gradient(145deg, rgba(255,255,255,.7), rgba(255,255,255,.35));
		box-shadow: 4px 4px 10px rgba(139,124,179,.1), -3px -3px 8px rgba(255,255,255,.8), inset 0 1px 1px rgba(255,255,255,.6);
		transition: all .35s cubic-bezier(0.34,1.56,0.64,1);
		animation: arch-tile-pop .45s cubic-bezier(0.34,1.56,0.64,1) backwards;
	}
	.dark .archive-tile {
		background: linear-gradient(145deg, rgba(46,43,58,.8), rgba(35,33,45,.6));
		box-shadow: 4px 4px 10px rgba(0,0,0,.35), -3px -3px 8px rgba(255,255,255,.03), inset 0 1px 1px rgba(255,255,255,.04);
	}
	.archive-tile:hover {
		transform: scale(0.96);
		box-shadow: 2px 2px 6px rgba(139,124,179,.15), -2px -2px 5px rgba(255,255,255,.6), inset 0 1px 1px rgba(255,255,255,.5);
	}
	.dark .archive-tile:hover {
		box-shadow: 2px 2px 6px rgba(0,0,0,.45), -2px -2px 5px rgba(255,255,255,.03);
	}
	.archive-tile-icon {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 15px;
		margin: 0 auto 6px;
		transition: transform .35s cubic-bezier(0.34,1.56,0.64,1);
	}
	.archive-tile:hover .archive-tile-icon {
		transform: scale(1.15) rotate(-8deg);
	}
	@keyframes arch-tile-pop {
		0% { opacity: 0; transform: scale(0.5) translateY(8px); }
		100% { opacity: 1; transform: scale(1) translateY(0); }
	}
	.archive-tag-pop {
		animation: arch-tile-pop .4s cubic-bezier(0.34,1.56,0.64,1) backwards;
	}
</style>

<script is:inline>
	document.querySelectorAll('a[href^="#"]').forEach(anchor => {
		anchor.addEventListener('click', function (e) {
			e.preventDefault();
			const target = document.querySelector(this.getAttribute('href'));
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});
	});
</script>
